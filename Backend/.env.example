# ==========================================
# AreaHustle Sahara CodeSwitch Challenge
# Backend Environment Configuration Template
# Copy this to .env (do NOT commit .env to git)
# ==========================================

# --- Speech-to-Text: Intron Sahara API ---
# Obtain from: https://voice.intron.io (Developer tab)
SAHARA_API_KEY=your_sahara_api_key_here

# --- Intent Extraction: Google Gemini API ---
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Dynamic model selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Database: MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=areahustle_fintech

# --- Offline Benchmark Comparison (Optional) ---
# Used only by tests/benchmark_runner.py to compare Sahara against OpenAI Whisper
OPENAI_API_KEY=your_openai_api_key_here

# --- Telephony Legacy Webhooks (Disabled in main.py) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
